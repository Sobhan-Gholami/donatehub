# Auth
JWT_SECRET=replace-with-a-long-random-string
# Optional: auto-create the first admin on boot (useful on hosts without a shell)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public URL (used for payment callbacks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Zarinpal: true = official sandbox (no real money moves)
ZARINPAL_SANDBOX=true

# OAuth (optional — enables Kick / YouTube connections)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
